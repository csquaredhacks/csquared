# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored. `make dev` loads it locally; `make secrets` turns it into the
# Kubernetes Secret `hallway-secrets`.
# Format rules (kubectl reads this file literally): KEY=value, no quotes, no spaces
# around "=", comments on their own line. An unused optional key can stay empty.

# --- Elasticsearch (required) ---
# Elastic Cloud -> your project -> "Connection details" -> Elasticsearch endpoint (https://...)
ES_URL=
# Elastic Cloud -> your project -> "API keys" -> Create API key (copy the encoded value)
ES_API_KEY=
# Inference endpoint id for ELSER. Find it with `GET _inference` in Kibana Dev Tools;
# on serverless it is usually .elser-2-elastic. Empty = lexical-only matching.
ELSER_ID=.elser-2-elastic

# --- OpenAI (optional) ---
# platform.openai.com -> API keys. Empty = the app runs without the LLM-written parts.
OPENAI_API_KEY=

# --- Sign in with Google and LinkedIn (optional) ---
# A button appears on the join page only when both of its values are set. With none set,
# people join with the plain form. How to get these: README, "Sign in with Google or LinkedIn".
# At each provider, register this redirect address (once per address people open):
#   <address>/api/signin/google/callback      <address>/api/signin/linkedin/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# The address people open, e.g. https://hallway.example. Leave empty: it is read from each
# request. Set it only if the redirect address the provider sees comes out wrong.
PUBLIC_URL=

# --- Admin ---
# Any random string, e.g. `openssl rand -hex 16`. Sent as the X-Admin-Token header to POST /api/chaos.
ADMIN_TOKEN=

# --- Dash0 telemetry (optional, but it is the point of the Dash0 track) ---
# Dash0 -> Settings -> Endpoints -> OTLP via gRPC. Keep the https:// prefix and the :4317 port,
# e.g. https://ingress.<region>.aws.dash0.com:4317
DASH0_OTLP_ENDPOINT=
# Dash0 -> Settings -> Auth Tokens -> create a token with Ingesting permission (starts with auth_)
DASH0_AUTH_TOKEN=
# `make dash0` puts the dashboard, check rules and SLO into Dash0 through its API.
# Dash0 -> Settings -> Endpoints -> API, e.g. https://api.<region>.aws.dash0.com
# It uses DASH0_AUTH_TOKEN above. If that token is ingest-only, also set DASH0_API_TOKEN.
DASH0_API_URL=
# Browser monitoring (RUM): the website-monitoring endpoint URL and its auth token from Dash0
# Settings. Leave both empty to disable.
DASH0_RUM_URL=
DASH0_RUM_TOKEN=

# --- Local dev only ---
# On the cluster these two come from deploy/chart/hallway/values.yaml, which wins over the Secret.
ROOMS=Main Stage,Room A,Room B,Coffee Bar,Quiet Room
CHAOS_ENABLED=true
